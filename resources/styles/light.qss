/* MedAudioLab v2 - light theme.
 *
 * Palette
 *   background  #f6f8fb      surface (inputs, tables)  #ffffff     subtle  #eef2f7
 *   foreground  #1f2937      muted text                #64748b     border  #cbd5e1 / #d8dee8
 *   accent      #2563eb      accent hover/pressed      #1d4ed8 / #1e40af
 *   danger      #dc2626      danger hover/pressed      #b91c1c / #991b1b
 *   selection   #dbeafe on   #1e3a8a text
 */

/* ------------------------------------------------------------------ base */
QWidget {
    background-color: #f6f8fb;
    color: #1f2937;
    font-family: "Segoe UI", "Helvetica Neue", Arial, sans-serif;
    font-size: 10pt;
}

QMainWindow, QDialog {
    background-color: #f6f8fb;
}

QLabel, QCheckBox, QRadioButton, QSlider {
    background: transparent;
}

QLabel:disabled, QCheckBox:disabled, QRadioButton:disabled {
    color: #94a3b8;
}

QLabel#muted {
    color: #64748b;
}

QLabel#header {
    font-weight: 600;
}

QLabel#status {
    font-weight: 600;
}

QLabel#status[error="true"] {
    color: #b91c1c;
}

QToolTip {
    background-color: #1f2937;
    color: #ffffff;
    border: 1px solid #1f2937;
    padding: 4px 6px;
}

/* ------------------------------------------------------------------ tabs */
QTabWidget::pane {
    border: 1px solid #d8dee8;
    border-radius: 0px 6px 6px 6px;
    background-color: #f6f8fb;
    top: -1px;
}

QTabBar {
    background: transparent;
}

QTabBar::tab {
    background-color: #eaeef4;
    color: #475569;
    border: 1px solid #d8dee8;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 8px 22px;
    margin-right: 2px;
    min-width: 70px;
}

QTabBar::tab:hover:!selected {
    background-color: #f1f5f9;
    color: #1f2937;
}

QTabBar::tab:selected {
    background-color: #ffffff;
    color: #1d4ed8;
    font-weight: 600;
    border-bottom: 3px solid #2563eb;
}

/* --------------------------------------------------------------- buttons */
QPushButton, QToolButton {
    background-color: #ffffff;
    color: #1f2937;
    border: 1px solid #cbd5e1;
    border-radius: 5px;
    padding: 6px 14px;
}

QPushButton:hover, QToolButton:hover {
    background-color: #eef2f7;
    border-color: #94a3b8;
}

QPushButton:pressed, QToolButton:pressed {
    background-color: #e2e8f0;
}

QPushButton:focus {
    border-color: #2563eb;
}

QPushButton:disabled, QToolButton:disabled {
    background-color: #eef2f7;
    color: #94a3b8;
    border-color: #e2e8f0;
}

QToolButton {
    padding: 4px 8px;
}

/* primary: the main action of a screen (blue accent) */
QPushButton#primary, QPushButton[variant="primary"] {
    background-color: #2563eb;
    color: #ffffff;
    border: 1px solid #2563eb;
    font-weight: 600;
}

QPushButton#primary:hover, QPushButton[variant="primary"]:hover {
    background-color: #1d4ed8;
    border-color: #1d4ed8;
}

QPushButton#primary:pressed, QPushButton[variant="primary"]:pressed {
    background-color: #1e40af;
    border-color: #1e40af;
}

/* danger: stops recordings and deletes data (red) */
QPushButton#danger, QPushButton[variant="danger"] {
    background-color: #dc2626;
    color: #ffffff;
    border: 1px solid #dc2626;
    font-weight: 600;
}

QPushButton#danger:hover, QPushButton[variant="danger"]:hover {
    background-color: #b91c1c;
    border-color: #b91c1c;
}

QPushButton#danger:pressed, QPushButton[variant="danger"]:pressed {
    background-color: #991b1b;
    border-color: #991b1b;
}

QPushButton#primary:disabled, QPushButton[variant="primary"]:disabled,
QPushButton#danger:disabled, QPushButton[variant="danger"]:disabled {
    background-color: #cbd5e1;
    border-color: #cbd5e1;
    color: #64748b;
}

/* -------------------------------------------------------------- group box */
QGroupBox {
    background: transparent;
    border: 1px solid #d8dee8;
    border-radius: 6px;
    margin-top: 12px;
    padding: 12px 8px 8px 8px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 4px;
    color: #334155;
    background-color: #f6f8fb;
}

QGroupBox:disabled {
    color: #94a3b8;
}

/* ----------------------------------------------------------------- inputs */
QLineEdit, QPlainTextEdit, QTextEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background-color: #ffffff;
    color: #1f2937;
    border: 1px solid #cbd5e1;
    border-radius: 4px;
    padding: 4px 6px;
    selection-background-color: #dbeafe;
    selection-color: #1e3a8a;
}

QLineEdit:hover, QPlainTextEdit:hover, QSpinBox:hover, QDoubleSpinBox:hover, QComboBox:hover {
    border-color: #94a3b8;
}

QLineEdit:focus, QPlainTextEdit:focus, QTextEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus,
QComboBox:focus, QComboBox:on {
    border: 1px solid #2563eb;
}

QLineEdit:disabled, QPlainTextEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled,
QComboBox:disabled {
    background-color: #eef2f7;
    color: #94a3b8;
    border-color: #e2e8f0;
}

QLineEdit:read-only {
    background-color: #f1f5f9;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #1f2937;
    border: 1px solid #cbd5e1;
    selection-background-color: #dbeafe;
    selection-color: #1e3a8a;
    outline: none;
}

/* Sizing an indicator alone makes Qt stop drawing it, so style every state. */
QCheckBox::indicator, QRadioButton::indicator {
    width: 14px;
    height: 14px;
    background-color: #ffffff;
    border: 2px solid #94a3b8;
}

QCheckBox::indicator {
    border-radius: 4px;
}

QRadioButton::indicator {
    border-radius: 9px;
}

QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border-color: #2563eb;
}

QCheckBox::indicator:checked {
    background-color: #2563eb;
    border-color: #2563eb;
}

QRadioButton::indicator:checked {
    background-color: qradialgradient(cx: 0.5, cy: 0.5, radius: 0.5, fx: 0.5, fy: 0.5,
        stop: 0 #2563eb, stop: 0.5 #2563eb, stop: 0.6 #ffffff, stop: 1 #ffffff);
    border-color: #2563eb;
}

QCheckBox::indicator:disabled, QRadioButton::indicator:disabled {
    background-color: #e2e8f0;
    border-color: #cbd5e1;
}

/* ------------------------------------------------------- item views, header */
QTreeWidget, QTreeView, QTableView, QListWidget {
    background-color: #ffffff;
    alternate-background-color: #f8fafc;
    color: #1f2937;
    border: 1px solid #d8dee8;
    border-radius: 4px;
    gridline-color: #e2e8f0;
    outline: none;
}

QTreeWidget::item, QTreeView::item, QListWidget::item {
    padding: 3px 4px;
}

QTreeWidget::item:hover, QTreeView::item:hover, QListWidget::item:hover {
    background-color: #eff6ff;
}

QTreeWidget::item:selected, QTreeView::item:selected, QTableView::item:selected,
QListWidget::item:selected {
    background-color: #dbeafe;
    color: #1e3a8a;
}

QTreeWidget:disabled, QTreeView:disabled {
    color: #94a3b8;
}

QHeaderView::section {
    background-color: #eef2f7;
    color: #334155;
    border: none;
    border-right: 1px solid #d8dee8;
    border-bottom: 1px solid #cbd5e1;
    padding: 5px 8px;
    font-weight: 600;
}

QHeaderView::section:hover {
    background-color: #e2e8f0;
}

/* --------------------------------------------------------------- progress */
QProgressBar {
    background-color: #e2e8f0;
    border: 1px solid #cbd5e1;
    border-radius: 7px;
    min-height: 14px;
    max-height: 14px;
    text-align: center;
    color: #1f2937;
    font-size: 8pt;
}

QProgressBar::chunk {
    background-color: #2563eb;
    border-radius: 6px;
}

/* ------------------------------------------------------------ scroll areas */
QScrollArea {
    border: none;
    background: transparent;
}

QScrollBar:vertical {
    background: transparent;
    width: 12px;
    margin: 0;
}

QScrollBar:horizontal {
    background: transparent;
    height: 12px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: #cbd5e1;
    border-radius: 5px;
    min-height: 28px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background-color: #cbd5e1;
    border-radius: 5px;
    min-width: 28px;
    margin: 2px;
}

QScrollBar::handle:hover {
    background-color: #94a3b8;
}

QScrollBar::add-line, QScrollBar::sub-line {
    width: 0;
    height: 0;
}

QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent;
}

QSplitter::handle {
    background-color: #d8dee8;
}

/* ------------------------------------------------------- menus, status bar */
QMenuBar {
    background-color: #ffffff;
    border-bottom: 1px solid #d8dee8;
    padding: 2px;
}

QMenuBar::item {
    background: transparent;
    padding: 5px 12px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: #dbeafe;
    color: #1e3a8a;
}

QMenu {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    padding: 4px;
}

QMenu::item {
    padding: 6px 28px 6px 24px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #dbeafe;
    color: #1e3a8a;
}

QMenu::item:disabled {
    color: #94a3b8;
}

QMenu::separator {
    height: 1px;
    background-color: #e2e8f0;
    margin: 4px 8px;
}

QStatusBar {
    background-color: #eef2f7;
    border-top: 1px solid #d8dee8;
    color: #334155;
}

QStatusBar::item {
    border: none;
}

QStatusBar QLabel {
    padding: 0 8px;
}

QMessageBox {
    background-color: #f6f8fb;
}
